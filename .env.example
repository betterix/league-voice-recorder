# ==========================================
# OBS Studio WebSocket Configuration
# ==========================================
# OBS WebSocket server host (default: localhost)
OBS_HOST=localhost

# OBS WebSocket server port (default: 4455)
OBS_PORT=4455

# OBS WebSocket server password (set in OBS: Tools -> WebSocket Server Settings)
OBS_PASSWORD=your_obs_websocket_password_here

# The target OBS scene to activate during match recording
OBS_SCENE_NAME=Discord Only

# ==========================================
# Application Paths & Settings
# ==========================================
# Directory where recorded .mp3 files will be stored.
# Uses %USERPROFILE% to automatically resolve to the CURRENT user's Documents folder.
RECORD_FOLDER=%USERPROFILE%\Documents\League Voice Recorder\recordings

# 64-bit VLC Media Player installation directory
VLC_DIR=C:\Program Files\VideoLAN\VLC

# Game status polling interval in seconds
CHECK_TIME=0.2

# Default replay audio playback volume percentage (0 - 100)
REPLAY_VOLUME=80

# Interface Language (default: en, e.g. en, hu)
LANGUAGE=en

# Auto-detect text files and normalize line endings across platforms
* text=auto

.gitattributes text eol=lf

# Source code & configs normalized to LF
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows batch files must retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.ico binary
*.png binary
*.svg text eol=lf
*.mp3 binary
*.wav binary
*.exe binary
*.zip binary
